<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="space.huyuhao.myagent.mapper.UserLlmConfigMapper">

    <select id="selectByUserId" resultType="space.huyuhao.myagent.entity.UserLlmConfig">
        SELECT * FROM user_llm_config WHERE user_id = #{userId} ORDER BY create_time DESC
    </select>

    <select id="selectByUserIdAndProvider" resultType="space.huyuhao.myagent.entity.UserLlmConfig">
        SELECT * FROM user_llm_config WHERE user_id = #{userId} AND provider = #{provider}
    </select>

</mapper>
